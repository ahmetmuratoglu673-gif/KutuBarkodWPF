<Window x:Class="KutuBarkodWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KutuBarkodWPF - Etiket Tasarım Stüdyosu" Height="750" Width="1350"
        FontFamily="Segoe UI" Background="#F3F3F3" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="Thumb" x:Key="ResizeThumbStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="AnimatedModernButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="#CC15151E" CornerRadius="12" BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#44FFFFFF" Offset="0"/>
                                        <GradientStop Color="#11FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="neonBorder" Opacity="0" CornerRadius="12" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="Red" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#D1B3FF" Offset="0"/>
                                        <GradientStop Color="#93C5FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="neonGlow" Color="#6366F1" BlurRadius="20" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" Panel.ZIndex="5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="neonBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="neonBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
            </Border.Effect>
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Background="#1E7145" Style="{StaticResource AnimatedModernButton}" Margin="0,0,5,0" Height="42" Click="ExcelSec_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📗" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Excel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="#FF8C00" Style="{StaticResource AnimatedModernButton}" Margin="0,0,5,0" Height="42" Click="YeniMetinEkle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✍️" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Metin" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Background="#E81123" Style="{StaticResource AnimatedModernButton}" Margin="0,0,10,0" Height="42" Click="TuvaliTemizle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Temizle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="txtSablonAdi" Width="100" Height="42" Margin="0,0,5,0" Padding="5,0" VerticalContentAlignment="Center" Background="#FAFAFA" BorderBrush="#D1D1D1" FontSize="14" Text="Şablon 1"/>
                    <Button Background="#0078D4" Style="{StaticResource AnimatedModernButton}" Margin="0,0,5,0" Height="42" Click="SablonKaydet_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kaydet" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="cmbSablonlar" Width="140" Height="42" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" Background="#FAFAFA" FontSize="12" Padding="5,0" SelectionChanged="cmbSablonlar_SelectionChanged">
                        <ComboBoxItem Content="Şablon Seç..." IsSelected="True" Foreground="Gray"/>
                    </ComboBox>
                    <Button Background="#D13438" Style="{StaticResource AnimatedModernButton}" Margin="5,0,10,0" Height="42" Click="SablonSil_Click" ToolTip="Seçili Şablonu Sil">
                        <TextBlock Text="🗑️" FontSize="18" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                        <CheckBox x:Name="chkSayfaNo" Content="Sayfa Numarası (A4 Altı)" Checked="chkSayfaNo_Checked" Unchecked="chkSayfaNo_Unchecked" FontSize="12" FontWeight="Medium" Foreground="#444" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkAdetSirasi" Content="Etiket Sırası (Örn: 01/600)" Checked="chkAdetSirasi_Checked" Unchecked="chkAdetSirasi_Unchecked" FontSize="12" FontWeight="Medium" Foreground="#444"/>
                    </StackPanel>
                    <Button Background="#D13438" Click="PdfOlustur_Click" Style="{StaticResource AnimatedModernButton}" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PDF OLUŞTUR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ETİKET ALANLARI" FontWeight="Bold" FontSize="16" Foreground="#222" Margin="0,0,0,15"/>
                    <ListBox Grid.Row="1" x:Name="lstEtiketAlanlari" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8" Width="280">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AlanAdi}" FontWeight="Bold" FontSize="13" Foreground="#333" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Etikette Olsun" IsChecked="{Binding EtiketteMi}" Checked="EtiketteOlsun_Checked" Unchecked="EtiketteOlsun_Unchecked" Margin="0,0,10,0" Foreground="#555" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
                                            <CheckBox Content="QR'da Olsun" IsChecked="{Binding QrDaMi}" Checked="QrOlsun_Checked" Unchecked="QrOlsun_Unchecked" Margin="0,0,10,0" Foreground="#555" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding QrSiraVisibility}">
                                                <TextBlock Text="QR Sıra:" Foreground="#555" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBox Text="{Binding QrSira, UpdateSourceTrigger=PropertyChanged}" TextChanged="QrSira_TextChanged" Width="25" Height="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#E5E9ED">
                <Grid>
                    <Grid.Background>
                        <DrawingBrush Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#DCE1E6">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,1"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Viewbox Stretch="Uniform" Margin="20" PreviewMouseWheel="Canvas_MouseWheel" MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
                        <Border Width="400" Height="380" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4">
                            <Border.LayoutTransform>
                                <ScaleTransform x:Name="canvasScale" ScaleX="1" ScaleY="1" />
                            </Border.LayoutTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="15" ShadowDepth="4"/>
                            </Border.Effect>
                            <Canvas x:Name="EtiketCanvas" Width="400" Height="380" Background="Transparent" ClipToBounds="True" Cursor="Arrow"/>
                        </Border>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="QR ÖN İZLEME" FontWeight="Bold" FontSize="16" Foreground="#222" Margin="0,0,0,15"/>
                    <TextBlock Text="Veri Ayırıcı Karakter (Örn: - / . _ )" FontSize="12" Foreground="#666" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox x:Name="txtQrAyirici" Text=" - " TextChanged="txtQrAyirici_TextChanged" Height="34" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" Background="#FAFAFA" FontSize="14" Margin="0,0,0,15"/>
                    <TextBlock Text="Telefonda Görünecek Veri:" FontSize="12" Foreground="#666" Margin="0,0,0,5" FontWeight="Medium"/>
                    <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" Padding="15" CornerRadius="8" MinHeight="80">
                        <TextBlock x:Name="txtQrOnizleme" Text="Henüz QR için veri seçilmedi..." TextWrapping="Wrap" Foreground="#0078D4" FontSize="14" FontWeight="Bold"/>
                    </Border>
                    <Rectangle Height="1" Fill="#E0E0E0" Margin="0,25"/>

                    <TextBlock Text="ŞABLON RENGİ" FontWeight="Bold" FontSize="16" Foreground="#222" Margin="0,0,0,10"/>
                    <Button Content="🎨 Şablon Çerçeve Rengi" Height="38" Background="#2B2B2B" Style="{StaticResource AnimatedModernButton}" Click="RenkSec_Click" Margin="0,0,0,10"/>

                    <TextBlock Text="METİN RENGİ" FontWeight="Bold" FontSize="16" Foreground="#222" Margin="0,15,0,10"/>
                    <Button Content="🔤 Seçili Metin Rengi" Height="38" Background="#0078D4" Style="{StaticResource AnimatedModernButton}" Click="MetinRenkSec_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" Panel.ZIndex="10" Padding="25,15,25,15">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="-2" Direction="90"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SEÇİLİ NESNE ÖZELLİKLERİ" FontWeight="Bold" FontSize="16" Foreground="#222" Margin="0,0,0,15"/>
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,15,10" Width="180">
                        <TextBlock Text="Metin İçeriği (Buradan Düzenle)" FontSize="12" Foreground="#666" Margin="0,0,0,6" FontWeight="Medium"/>
                        <TextBox x:Name="txtIcerik" TextChanged="txtIcerik_TextChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" Background="#FAFAFA" FontSize="14" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10" Width="60">
                        <TextBlock Text="X" FontSize="12" Foreground="#666" Margin="0,0,0,6" FontWeight="Medium"/>
                        <TextBox x:Name="txtX" Text="0" TextChanged="Prop_TextChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" Background="#FAFAFA" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10" Width="60">
                        <TextBlock Text="Y" FontSize="12" Foreground="#666" Margin="0,0,0,6" FontWeight="Medium"/>
                        <TextBox x:Name="txtY" Text="0" TextChanged="Prop_TextChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" Background="#FAFAFA" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10" Width="60">
                        <TextBlock Text="Genişlik" FontSize="12" Foreground="#666" Margin="0,0,0,6" FontWeight="Medium"/>
                        <TextBox x:Name="txtGenislik" Text="Auto" TextChanged="Prop_TextChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" Background="#FAFAFA" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10" Width="60">
                        <TextBlock Text="Yükseklik" FontSize="12" Foreground="#666" Margin="0,0,0,6" FontWeight="Medium"/>
                        <TextBox x:Name="txtYukseklik" Text="Auto" TextChanged="Prop_TextChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" Background="#FAFAFA" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10" Width="60">
                        <TextBlock Text="Punto" FontSize="12" Foreground="#666" Margin="0,0,0,6" FontWeight="Medium"/>
                        <TextBox x:Name="txtPunto" Text="12" TextChanged="Prop_TextChanged" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#D1D1D1" BorderThickness="1" Background="#FAFAFA" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,10" VerticalAlignment="Bottom">
                        <CheckBox x:Name="chkBold" Content="Kalın" Checked="chkBold_Changed" Unchecked="chkBold_Changed" Height="34" VerticalContentAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#333"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,10" VerticalAlignment="Bottom">
                        <CheckBox x:Name="chkMetniOrtala" Content="İçeriği Ortala" Checked="chkMetniOrtala_Changed" Unchecked="chkMetniOrtala_Changed" Height="34" VerticalContentAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#333"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,10" VerticalAlignment="Bottom">
                        <Button Content="↔ Sayfada Ortala" Background="#0078D4" Style="{StaticResource AnimatedModernButton}" Width="140" Height="34" Click="btnSayfadaOrtala_Click" ToolTip="Seçili öğeyi etiket sayfasına (kırmızı çerçeveye) göre tam merkeze yerleştirir."/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <Button Content="🗑️ Sil" Background="#E81123" Style="{StaticResource AnimatedModernButton}" Width="90" Height="34" Click="SeciliSil_Click"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>